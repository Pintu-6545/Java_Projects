package com.dao;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.util.ArrayList;
import java.util.List;

import com.bean.Wishlist;
import com.util.ElectroUtil;

public class WishlistDao {
	
	public static void addToWishlist(Wishlist w)
	{
		try {
	     		Connection conn = ElectroUtil.createConnection();
	     		String sql="insert into wishlist (pid,user_id) values(?,?)";
	     		PreparedStatement pst = conn.prepareStatement(sql);
	     		pst.setInt(1, w.getPid());
	     		pst.setInt(2, w.getUser_id());
	     		pst.executeUpdate();
		  	
		} catch (Exception e) {
			e.printStackTrace();
		}
	}
	
	//  view Wishlist data
	public static List<Wishlist> getWiListByUser(int user_id)
	{
	    List<Wishlist> list = new ArrayList<Wishlist>();
	    try {
	        Connection conn = ElectroUtil.createConnection();
	        String sql="select * from wishlist where user_id=?";
	        PreparedStatement pst = conn.prepareStatement(sql);
	        pst.setInt(1, user_id);
	        ResultSet rs = pst.executeQuery();

	        while(rs.next())    // <- FIXED
	        {
	            Wishlist w = new Wishlist();
	            w.setWid(rs.getInt("wid"));
	            w.setPid(rs.getInt("pid"));
	            w.setUser_id(rs.getInt("user_id"));
	            list.add(w);
	        }
	    } catch (Exception e) {
	        e.printStackTrace();
	    }
	    return list;
	}

// remove Wishlist product data
	
	public static boolean checkWishlist(int pid,int user_id)
	{
		boolean flag=false;
		try {
			Connection conn = ElectroUtil.createConnection();
			String sql="select * from wishlist where pid=? and user_id=?";
			PreparedStatement pst = conn.prepareStatement(sql);
			pst.setInt(1, pid);
			pst.setInt(2, user_id);
			ResultSet rs = pst.executeQuery();
			if(rs.next())
			{
				flag=true;
			}
		} catch (Exception e) {
			e.printStackTrace();
		} 
		return flag;
	}

}
